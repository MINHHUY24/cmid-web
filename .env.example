VITE_API_URL=http://localhost:3000/api
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
VITE_ADMIN_API_ENABLED=false
# Only for local `npm run dev`: test payment flow and automatically complete it when the QR timer ends.
# Do not use a QR that can receive money while this is `mock`.
VITE_PAYMENT_MODE=mock

# Optional checkout QR display information. Values prefixed with VITE_ are public.
VITE_PAYMENT_RECIPIENT_NAME=LÊ MINH HUY
VITE_VNPAY_BANK_ID=TCB
VITE_VNPAY_BANK_NAME=Techcombank
VITE_VNPAY_ACCOUNT_NUMBER=241058736252
VITE_MOMO_ACCOUNT_LABEL=******097
# Public Zalo OA/chat URL for the floating contact button. Replace with CMID's official Zalo URL.
VITE_ZALO_URL=https://zalo.me/
# The number shown beside the Zalo button on hover.
VITE_ZALO_PHONE=1800 6868
# Set these to an image URL (or /public file path) to use your own QR artwork.
# For a QR that receives real money, remove VITE_PAYMENT_MODE=mock first. Confirmation then needs a payment webhook.
VITE_VNPAY_QR_IMAGE_URL=
VITE_MOMO_QR_IMAGE_URL=
